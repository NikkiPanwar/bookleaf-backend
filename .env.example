# ==============================================================================
# BookLeaf Backend Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/bookleaf_db

# JWT Security
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (LLM API key - Keep private on backend, NEVER expose to Angular frontend)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
